generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  
  // Relations
  moods        MoodEntry[]
  journals     JournalEntry[]
  workouts     WorkoutSession[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model MoodEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  moodScore Int      // 1-5 scale (1: terrible, 5: great)
  note      String?  @db.Text
  date      DateTime @default(now())

  createdAt DateTime @default(now())
  
  @@index([userId, date])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  content   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model WorkoutSession {
  id         String           @id @default(cuid())
  title      String
  workoutType String
  duration   Int?
  calories   Int?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises  WorkoutExercise[]

  @@index([userId])
  @@index([createdAt])
}

model WorkoutExercise {
  id        String          @id @default(cuid())
  name      String
  sets      Int?
  reps      Int?
  weight    Float?
  workoutId String
  workout   WorkoutSession  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([workoutId])
}

model TherapySession {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  duration    Int
  thumbnail   String?
  audioUrl    String
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model YogaSession {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  category    String   // e.g., "Relaxation", "Energizing", "Flexibility", "Strength"
  level       String   // e.g., "Beginner", "Intermediate", "Advanced"
  duration    Int      // in minutes
  thumbnail   String?
  videoUrl    String
  poseCount   Int?     // number of poses in the session
  intensity   String?  // "low", "medium", "high"
  benefits    String?  @db.Text // comma-separated list of benefits
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([level])
  @@index([createdAt])
}
